diff --git a/src-tauri/src/history_drag.rs b/src-tauri/src/history_drag.rs
new file mode 100644
index 0000000..cbd42f6
--- /dev/null
+++ b/src-tauri/src/history_drag.rs
@@ -0,0 +1,72 @@
+#[cfg(target_os = "windows")]
+extern "C" {
+  fn wait_for_drag_exit(window: usize, has_payload: i32) -> i32;
+  fn drag_history_payload(window: usize, payload: *const u16, is_file: i32) -> i32;
+}
+
+/// Leave an in-window gesture with the webview. Start a Windows copy drag
+/// when the same press moves to another window.
+#[tauri::command]
+pub async fn track_external_history_drag(
+  window: tauri::Window,
+  history_id: String,
+) -> Result<bool, String> {
+  #[cfg(not(target_os = "windows"))]
+  {
+    let _ = (window, history_id);
+    Ok(true)
+  }
+
+  #[cfg(target_os = "windows")]
+  {
+    use std::os::windows::ffi::OsStrExt;
+    use std::path::Path;
+    use std::sync::Arc;
+
+    let handle = window.hwnd().map_err(|error| error.to_string())?.0 as usize;
+    tauri::async_runtime::spawn_blocking(move || {
+      let mut payload = Vec::new();
+      let mut is_file = false;
+      if let Some(item) = crate::services::history_service::get_clipboard_history_by_id(&history_id)
+      {
+        if item.is_image.unwrap_or(false) && !item.is_link.unwrap_or(false) {
+          if let Some(path) = item.image_path_full_res {
+            let path = crate::db::to_absolute_image_path(&path);
+            if Path::new(&path).is_file() {
+              payload.extend(Path::new(&path).as_os_str().encode_wide());
+              is_file = true;
+            }
+          }
+        } else if let Some(value) = item.value {
+          payload.extend(value.encode_utf16());
+        }
+      }
+      payload.push(0);
+      let payload = Arc::new(payload);
+      loop {
+        let destination = unsafe { wait_for_drag_exit(handle, i32::from(payload.len() > 1)) };
+        if destination != 2 {
+          return Ok(destination == 1);
+        }
+
+        // The foreground window's thread must start OLE's mouse capture.
+        // Wait on this worker so that in-app dragging can still process events.
+        let (sender, receiver) = std::sync::mpsc::sync_channel(1);
+        let drag_payload = Arc::clone(&payload);
+        window
+          .run_on_main_thread(move || {
+            let result =
+              unsafe { drag_history_payload(handle, drag_payload.as_ptr(), i32::from(is_file)) };
+            let _ = sender.send(result);
+          })
+          .map_err(|error| error.to_string())?;
+        let result = receiver.recv().map_err(|error| error.to_string())?;
+        if result != 2 {
+          return Ok(result == 1);
+        }
+      }
+    })
+    .await
+    .map_err(|error| error.to_string())?
+  }
+}
diff --git a/src-tauri/src/history_drag_windows.cpp b/src-tauri/src/history_drag_windows.cpp
new file mode 100644
index 0000000..977e709
--- /dev/null
+++ b/src-tauri/src/history_drag_windows.cpp
@@ -0,0 +1,171 @@
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#include <ole2.h>
+#include <shellapi.h>
+#include <shlobj.h>
+#include <cstdint>
+#include <cstring>
+#include <string>
+
+namespace {
+bool cursor_is_in_window(HWND window) {
+  POINT cursor{};
+  return GetCursorPos(&cursor) &&
+         GetAncestor(WindowFromPoint(cursor), GA_ROOT) == window;
+}
+
+bool left_button_is_down() {
+  return (GetAsyncKeyState(VK_LBUTTON) & 0x8000) != 0;
+}
+
+class HistoryDragData final : public IDataObject {
+public:
+  HistoryDragData(const wchar_t* value, bool file)
+      : value_(value), format_(file ? CF_HDROP : CF_UNICODETEXT) {}
+
+  HRESULT STDMETHODCALLTYPE QueryInterface(REFIID id, void** result) override {
+    if (!result) return E_POINTER;
+    *result = nullptr;
+    if (id != IID_IUnknown && id != IID_IDataObject) return E_NOINTERFACE;
+    *result = static_cast<IDataObject*>(this);
+    AddRef();
+    return S_OK;
+  }
+
+  ULONG STDMETHODCALLTYPE AddRef() override { return ++references_; }
+  ULONG STDMETHODCALLTYPE Release() override {
+    const ULONG count = --references_;
+    if (count == 0) delete this;
+    return count;
+  }
+
+  HRESULT STDMETHODCALLTYPE GetData(FORMATETC* request, STGMEDIUM* medium) override {
+    if (!medium) return E_POINTER;
+    const HRESULT result = QueryGetData(request);
+    if (FAILED(result)) return result;
+
+    const bool file = format_ == CF_HDROP;
+    const size_t bytes = (value_.size() + 1) * sizeof(wchar_t);
+    const size_t offset = file ? sizeof(DROPFILES) : 0;
+    HGLOBAL memory = GlobalAlloc(GMEM_MOVEABLE | GMEM_ZEROINIT,
+                                 offset + bytes + (file ? sizeof(wchar_t) : 0));
+    if (!memory) return E_OUTOFMEMORY;
+    auto* buffer = static_cast<unsigned char*>(GlobalLock(memory));
+    if (!buffer) {
+      GlobalFree(memory);
+      return E_OUTOFMEMORY;
+    }
+    if (file) {
+      auto* header = reinterpret_cast<DROPFILES*>(buffer);
+      header->pFiles = sizeof(DROPFILES);
+      header->fWide = TRUE;
+    }
+    std::memcpy(buffer + offset, value_.c_str(), bytes);
+    GlobalUnlock(memory);
+    *medium = {};
+    medium->tymed = TYMED_HGLOBAL;
+    medium->hGlobal = memory;
+    return S_OK;
+  }
+
+  HRESULT STDMETHODCALLTYPE QueryGetData(FORMATETC* request) override {
+    if (!request) return E_POINTER;
+    if (request->cfFormat != format_) return DV_E_FORMATETC;
+    if (request->dwAspect != DVASPECT_CONTENT) return DV_E_DVASPECT;
+    if (request->lindex != -1) return DV_E_LINDEX;
+    if (!(request->tymed & TYMED_HGLOBAL)) return DV_E_TYMED;
+    return S_OK;
+  }
+
+  HRESULT STDMETHODCALLTYPE EnumFormatEtc(DWORD direction, IEnumFORMATETC** formats) override {
+    if (direction != DATADIR_GET) return E_NOTIMPL;
+    FORMATETC format{format_, nullptr, DVASPECT_CONTENT, -1, TYMED_HGLOBAL};
+    return SHCreateStdEnumFmtEtc(1, &format, formats);
+  }
+
+  HRESULT STDMETHODCALLTYPE GetDataHere(FORMATETC*, STGMEDIUM*) override { return E_NOTIMPL; }
+  HRESULT STDMETHODCALLTYPE GetCanonicalFormatEtc(FORMATETC*, FORMATETC* output) override {
+    if (output) output->ptd = nullptr;
+    return E_NOTIMPL;
+  }
+  HRESULT STDMETHODCALLTYPE SetData(FORMATETC*, STGMEDIUM*, BOOL) override { return E_NOTIMPL; }
+  HRESULT STDMETHODCALLTYPE DAdvise(FORMATETC*, DWORD, IAdviseSink*, DWORD*) override {
+    return OLE_E_ADVISENOTSUPPORTED;
+  }
+  HRESULT STDMETHODCALLTYPE DUnadvise(DWORD) override { return OLE_E_ADVISENOTSUPPORTED; }
+  HRESULT STDMETHODCALLTYPE EnumDAdvise(IEnumSTATDATA**) override { return OLE_E_ADVISENOTSUPPORTED; }
+
+private:
+  ULONG references_ = 1;
+  std::wstring value_;
+  CLIPFORMAT format_;
+};
+
+class HistoryDragSource final : public IDropSource {
+public:
+  explicit HistoryDragSource(HWND window) : window_(window) {}
+
+  HRESULT STDMETHODCALLTYPE QueryInterface(REFIID id, void** result) override {
+    if (!result) return E_POINTER;
+    *result = nullptr;
+    if (id != IID_IUnknown && id != IID_IDropSource) return E_NOINTERFACE;
+    *result = static_cast<IDropSource*>(this);
+    AddRef();
+    return S_OK;
+  }
+
+  ULONG STDMETHODCALLTYPE AddRef() override { return ++references_; }
+  ULONG STDMETHODCALLTYPE Release() override {
+    const ULONG count = --references_;
+    if (count == 0) delete this;
+    return count;
+  }
+
+  HRESULT STDMETHODCALLTYPE QueryContinueDrag(BOOL escape, DWORD keys) override {
+    if (escape || !IsWindow(window_)) return DRAGDROP_S_CANCEL;
+    returned = cursor_is_in_window(window_);
+    if (returned) return DRAGDROP_S_CANCEL;
+    return (keys & MK_LBUTTON) ? S_OK : DRAGDROP_S_DROP;
+  }
+
+  HRESULT STDMETHODCALLTYPE GiveFeedback(DWORD) override { return DRAGDROP_S_USEDEFAULTCURSORS; }
+
+  bool returned = false;
+
+private:
+  ULONG references_ = 1;
+  HWND window_;
+};
+} // namespace
+
+// Return 1 for an in-window release and 2 for a pending boundary crossing.
+extern "C" int wait_for_drag_exit(std::uintptr_t handle, int has_payload) {
+  HWND window = reinterpret_cast<HWND>(handle);
+  while (IsWindow(window)) {
+    if (GetAsyncKeyState(VK_ESCAPE) & 0x8000) return 0;
+    if (!left_button_is_down()) return cursor_is_in_window(window);
+    if (has_payload && !cursor_is_in_window(window)) return 2;
+    Sleep(10);
+  }
+  return 0;
+}
+
+extern "C" int drag_history_payload(std::uintptr_t handle, const wchar_t* payload, int is_file) {
+  HWND window = reinterpret_cast<HWND>(handle);
+  if (!IsWindow(window)) return 0;
+  if (!left_button_is_down()) return cursor_is_in_window(window);
+  if (cursor_is_in_window(window)) return 2;
+
+  const HRESULT ole = OleInitialize(nullptr);
+  if (FAILED(ole)) return 0;
+  auto* data = new HistoryDragData(payload, is_file != 0);
+  auto* source = new HistoryDragSource(window);
+  DWORD effect = DROPEFFECT_NONE;
+  const HRESULT result = DoDragDrop(data, source, DROPEFFECT_COPY, &effect);
+  const bool returned = source->returned;
+  data->Release();
+  source->Release();
+  OleUninitialize();
+  // A return to PasteBar hands the same press back to the in-window drag.
+  return result == DRAGDROP_S_CANCEL && returned ? 2 : 0;
+}
diff --git a/src-tauri/tests/history_drag_windows.cpp b/src-tauri/tests/history_drag_windows.cpp
new file mode 100644
index 0000000..ce27cca
