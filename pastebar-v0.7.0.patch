+++ b/src-tauri/tests/history_drag_windows.cpp
@@ -0,0 +1,41 @@
+#include "../src/history_drag_windows.cpp"
+#include <cassert>
+#include <iostream>
+
+int main() {
+  const HRESULT initialized = OleInitialize(nullptr);
+  assert(SUCCEEDED(initialized));
+
+  const std::wstring expected_text = L"Clipboard test \u526a\u8d34\u677f\r\nSecond line";
+  auto* text = new HistoryDragData(expected_text.c_str(), false);
+  FORMATETC text_format{CF_UNICODETEXT, nullptr, DVASPECT_CONTENT, -1, TYMED_HGLOBAL};
+  STGMEDIUM text_data{};
+  assert(text->GetData(&text_format, &text_data) == S_OK);
+  const auto* stored_text = static_cast<const wchar_t*>(GlobalLock(text_data.hGlobal));
+  assert(expected_text == stored_text);
+  GlobalUnlock(text_data.hGlobal);
+  ReleaseStgMedium(&text_data);
+  text->Release();
+
+  const std::wstring expected_file = L"D:\\clipboard test\\\u56fe\u7247.png";
+  auto* file = new HistoryDragData(expected_file.c_str(), true);
+  assert(file->QueryGetData(&text_format) == DV_E_FORMATETC);
+  IEnumFORMATETC* formats = nullptr;
+  assert(file->EnumFormatEtc(DATADIR_GET, &formats) == S_OK);
+  FORMATETC file_format{};
+  assert(formats->Next(1, &file_format, nullptr) == S_OK);
+  assert(file_format.cfFormat == CF_HDROP);
+  formats->Release();
+  STGMEDIUM file_data{};
+  assert(file->GetData(&file_format, &file_data) == S_OK);
+  HDROP drop = static_cast<HDROP>(file_data.hGlobal);
+  assert(DragQueryFileW(drop, 0xFFFFFFFF, nullptr, 0) == 1);
+  wchar_t file_name[MAX_PATH]{};
+  DragQueryFileW(drop, 0, file_name, MAX_PATH);
+  assert(expected_file == file_name);
+  ReleaseStgMedium(&file_data);
+  file->Release();
+
+  OleUninitialize();
+  std::cout << "Windows received the Unicode text and one PNG file path.\n";
+}
